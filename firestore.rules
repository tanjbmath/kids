rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All profile mutations and score writes must go through trusted Cloud Functions.
    match /students/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      allow write: if false;

      match /attempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == studentId;
        allow write: if false;
      }
    }

    // No client-side access to PIN hashes, login throttling state, or other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
