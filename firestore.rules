rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "jansencastella2@gmail.com";
    }
    function isOwner(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create: if isOwner(studentId) && !exists(/databases/$(database)/documents/blockedStudents/$(studentId));
      allow update: if isAdmin() || (isOwner(studentId) && !exists(/databases/$(database)/documents/blockedStudents/$(studentId)));
      allow delete: if isAdmin();

      match /attempts/{attemptId} {
        allow read, write: if isAdmin() || isOwner(studentId);
      }
    }

    // Only the administrator may see or create these records. They prevent a deleted
    // profile from being recreated with the same Google account.
    match /blockedStudents/{studentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
